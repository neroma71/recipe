{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}
{% block stylesheets %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
 <link rel="stylesheet" href="{{ asset('asset/css/register.css') }}">
{% endblock %}
{% block body %}
<header>
  <h1>Inscription</h1>
  <a href="{{ path('app_home') }}">Retour à l'accueil</a>
</header>
<div class="container">
    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}
        {{ form_row(registrationForm.email) }}
        {{ form_row(registrationForm.fullName) }}
        {{ form_row(registrationForm.pseudo) }}
        {{ form_row(registrationForm.plainPassword, {
            label: 'Mot de passe'
        }) }}
     {{ form_row(registrationForm.agreeTerms, {label: 'J\'accepte les conditions'}) }}

        <button type="submit" class="btn btn-primary">Enregistrement</button>
    {{ form_end(registrationForm) }}
</div>
{% endblock %}
