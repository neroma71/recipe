{% extends 'base.html.twig' %}

{% block title %}Recettes{% endblock %}

{% block stylesheets %}
 <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('asset/css/allrecipe.css') }}">
{% endblock %}

{% block body %}
<main>
    <header>
        <button id="connexion">
            <a class="nav-link" href="{{ path('app_recipe') }}">Connexion</a>
        </button>
            <nav>
                <ul>
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li><a href="{{ path('app_public_post') }}">Tous les articles</a></li>
                    <li><a href="{{ path('app_register')}}">Inscription</a></li>
                </ul>
            </nav>
                <h1>Toutes les recettes</h1>
    </header>
    <div class="banner">
       <p> Il y a {{ recipes.getTotalItemCount }} recettes</p>
    </div>
    <div id="container">
    <h2 id="subtitle">Les recettes</h2>
        <div class="card-container">
            {% for recipe in recipes %}
             <a href="{{ path('recipe_show', { id: recipe.id }) }}">
                <div class="card">
                    <h3>
                        {{ recipe.name }}
                    </h3>
                    <p>Prix : 
                        {% if recipe.price is null %}
                            Non renseigné
                        {% else %}
                            {{ recipe.price }} €
                        {% endif %}
                    </p>
                    <p>Difficulté : 
                        {% if recipe.difficulty is null %}
                            Non renseigné
                        {% else %}
                            {{ recipe.difficulty }}
                        {% endif %}
                    </p>
                    <p>Date de création : {{ recipe.createdAt|date('d/m/Y') }}</p>
                    <img src="{{ asset('asset/upload/' ~ recipe.images) }}" alt="{{ recipe.name }}" class="img-fluid">
                </div>
                 </a>
            {% endfor %}
        </div>
        
        <div class="navigation">
            {{ knp_pagination_render(recipes) }}
        </div>
    </div>
</main>
{% endblock %}
