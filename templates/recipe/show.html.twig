{% extends 'base.html.twig' %}

{% block title %}{{ recipe.name }}{% endblock %}
{% block stylesheets %}
 <link rel="stylesheet" href="{{ asset('asset/css/show.css') }}">
{% endblock %}

{% block body %}
   <header class="recipe-header" style="background-image: url('{{ asset('asset/upload/' ~ recipe.images) }}');">
   <nav>
        <ul>
            <li><a class="nav-link" href="{{ path('app_home') }}">Accueil</a></li>
            <li><a class="nav-link" href="{{ path('app_login') }}">Mon compte</a></li>
            <li><a class="nav-link" href="{{ path('app_recipe') }}">Mes recettes</a></li>
            <li><a class="nav-link" href="{{ path('app_ingredient') }}">Mes ingrédients</a></li>
        </ul>
    </nav>
        <h1>{{ recipe.name }}</h1>
    </header>
    <div class="banner">
        <p class="auteur">La recette de : {{ recipe.user.pseudo }}</p>
    </div>
    <div class="container">
    <h2>{{ recipe.name }}</h2>
    <img src="{{ asset('asset/upload/' ~ recipe.images) }}" alt="Image de {{ recipe.name }}" class="img-fluid">
        <h3>Infos pratiques :</h3>
            <p>Date de création : {{recipe.createdAt|date('d/m/Y')}}</p>
            {% if recipe.time %}
            <p>Temps de réalisation : {{recipe.time}} minutes</p>
                {% else %}
               Temps non renseigné !
         {% endif %}
         {% if recipe.nbPeople %}
            <p>Pour {{ recipe.nbPeople }} personnes</p>
                {% else %}
               Nombre de personne non renseigné !
                {% endif %}
            {% if recipe.difficulty %}
            <p>Difficulté : {{ recipe.difficulty }} / 6</p>
                {% else %}
               Difficulté non renseignée !
             {% endif %}
         {% if recipe.price %}
            <p>Prix : {{ recipe.price }} €</p>
              {% else %}
              Prix non renseigné !
             {% endif %}
         {% if recipe.description %}
            {% else %}
        Recette non renseignée !
            {% endif %}
         <h3>Ingrédients :</h3>
          <div class="ingredients">
                {% for ingredient in recipe.ingredients %}
                <div class="produits">
                    <img src="{{ asset('asset/upload/' ~ ingredient.images) }}" alt="{{ ingredient.name }}">
                    <p> {{ ingredient.name }} {{ingredient.price}}€ / kg</p>
                </div>
             {% endfor %}
         </div>
          <div>
            <h3>Préparation :</h3>
           <p class="description">{{ recipe.description|nl2br}}</p>
        </div>
    </div>
    <footer></footer>
{% endblock %}