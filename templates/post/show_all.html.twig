{% extends 'base.html.twig' %}

{% block title %}Post{% endblock %}

{% block body %}
    <table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
        </tr>
    </thead>
    <tbody>
        {% for post in posts %}
        <tr>
            <td> {% if post.image %}<img src="{{ asset('asset/upload/' ~ post.image) }}" alt="Image de l'article">{% endif %}</td>
            <td>{{ post.id }}</td>
            <td>{{ post.title }}</td> 
            <td>{{ post.content }}</td> 
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}