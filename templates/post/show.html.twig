{% extends 'base.html.twig' %}

{% block title %}Post{% endblock %}

{% block body %}
    <h1>Post</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ post.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ post.Title }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ post.Date ? post.Date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Content</th>
                <td>{{ post.Content }}</td>
            </tr>
            <tr>
                <td>
                    {% if post.image %}<img src="{{ asset('asset/upload/' ~ post.image) }}" alt="Image de l'article">{% endif %}
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_post_index') }}">back to list</a>

    <a href="{{ path('app_post_edit', {'id': post.id}) }}">edit</a>

    {{ include('post/_delete_form.html.twig') }}
{% endblock %}
