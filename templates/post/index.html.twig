{% extends 'base.html.twig' %}

{% block title %}Post index{% endblock %}
{% block stylesheets %}
 <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('asset/css/table.css') }}">
{% endblock %}
{% block body %}
<section class=".container-fluid">
<header>
    <h1>Articles</h1>
</header>
    <div class="row">
        <a href="{{ path('app_post_new') }}">Create new</a>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>Numéro</th>
                <th>Image</th>
                <th>Title</th>
                <th>Date</th>
                <th>Show</th>
                <th>Edit</th>
            </tr>
        </thead>
        <tbody>
        {% for post in posts %}
            <tr>
                <td>{{ post.id }}</td>
                <td> {% if post.image %}<img src="{{ asset('asset/upload/' ~ post.image) }}" alt="Image de l'article">{% endif %}</td>
                <td>{{ post.Title }}</td>
                <td>{{ post.Date ? post.Date|date('Y-m-d') : '' }}</td>
                <td>
                    <a href="{{ path('app_post_show', {'id': post.id}) }}">show</a>
                </td>
                <td> <a href="{{ path('app_post_edit', {'id': post.id}) }}">edit</a></td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</section>
{% endblock %}
