{% extends 'base.html.twig' %}
{% block title %}Articles Publics{% endblock %}
{% block stylesheets %}
 <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('asset/css/liste.css') }}">
{% endblock %}
{% block body %}
<header>
    <h1>Articles</h1>
</header>
<section class="articles">
            {% for post in posts %}
        <div class="card">   
            <a href="{{ path('app_public_post_show', { 'id': post.id }) }}">  
              <div class="text">      
                <p>{{ post.title }}</p>
                <p class="auteur">Auteur : {{ post.user.pseudo }}</p>
              </div>
            </a>
                 {% if post.image %}<img src="{{ asset('asset/upload/' ~ post.image) }}" alt="Image de l'article">{% endif %}
        </div>    
            {% else %}
                    <p>Aucun article trouvé.</p>
            {% endfor %}
            <div class="navigation">
                {{ knp_pagination_render(posts) }}
          </div>     
    </section>
    <footer>

    </footer>
{% endblock %}
